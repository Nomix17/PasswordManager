{
  "manifest_version": 3,
  "name": "Password Manager",
  "version": "1.0.0",
  "description": "A Chrome extension password manager.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Password Manager"
  },
  "background": {
    "service_worker": "TriggerPopupListener.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["HandlePasswordForms.js"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://localhost:8080/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
